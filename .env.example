# Copy this file to .env and fill in your values.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which Claude model to use for answering questions.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection string. Matches docker-compose.yml defaults.
# Note: port 5434 (not 5432) so this can run alongside other local
# Postgres/pgvector projects (e.g. rag-docs-chat) without a port clash.
DATABASE_URL=postgresql://codeuser:codepassword@localhost:5434/codebasechat

# Local embedding model (sentence-transformers). 384-dim output must match
# the `vector(384)` column in sql/init.sql if you change this.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How many chunks to retrieve per query (chat and search).
TOP_K=8

# Max file size (bytes) to ingest; larger files are skipped.
MAX_FILE_SIZE_BYTES=1000000

# Where cloned git repos are checked out during ingestion.
CLONE_WORKDIR=./data/clones
